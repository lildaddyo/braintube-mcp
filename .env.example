SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-key>
WRITE_BACK_SECRET=<random-32-char-string>
PORT=3000
NODE_ENV=production

# Encrypts third-party tokens stored at rest (legacy Notion API keys). Any random string of 32+ chars.
# Unset = tokens are stored unencrypted with a startup warning. Generate: openssl rand -base64 48
SECRET_BOX_KEY=
